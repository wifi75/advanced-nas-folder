# Advanced NAS Folder - configurazione di esempio
#
# Copiare in .env e adattare. install.sh genera automaticamente i segreti.
# ATTENZIONE: .env non va MAI committato. Nessun dato reale del proprio
# impianto (indirizzi, domini, nomi delle condivisioni) deve finire qui dentro.

# --- Applicazione ---
ANF_ENV=production
ANF_HOST=127.0.0.1
ANF_PORT=8100
ANF_BASE_URL=https://esempio.local
ANF_LOG_LEVEL=INFO

# --- Sicurezza ---
# Generare con: openssl rand -hex 32
ANF_SECRET_KEY=CAMBIAMI_generato_da_install_sh
ANF_ACCESS_TOKEN_MINUTES=30
ANF_REFRESH_TOKEN_DAYS=14

# --- Database SQLite ---
# Nessun server da installare: un solo file, di proprieta dell'utente anf.
ANF_DB_PATH=/var/lib/anf/anf.sqlite3
# WAL: consente letture durante le scritture. Non disattivare.
ANF_DB_WAL=true

# --- Agent privilegiato ---
# Socket Unix su cui l'agent root riceve i comandi tipizzati dall'API.
ANF_AGENT_SOCKET=/run/anf/agent.sock
# Radice sotto cui l'agent puo montare. Nessun mount e ammesso fuori da qui.
ANF_MOUNT_ROOT=/srv/nas

# --- Consegna dei download ---
# xsendfile = Apache (mod_xsendfile) | xaccel = Nginx | stream = solo sviluppo
ANF_DOWNLOAD_BACKEND=xsendfile
# Prefisso interno usato da Nginx per X-Accel-Redirect
ANF_XACCEL_PREFIX=/__anf_internal

# --- Monitoraggio download ---
# File di log del web server letto in tempo reale per la dashboard.
ANF_ACCESS_LOG=/var/log/apache2/anf_access.log
# Reti fidate da cui accettare X-Forwarded-For (il reverse proxy).
ANF_TRUSTED_PROXIES=127.0.0.1

# Cartella in cui l'installer mette i file compilati del pannello.
# Serve alla configurazione del web server, che deve sapere cosa servire.
ANF_PANEL_DIR=/var/www/advanced-nas-folder/frontend/dist
