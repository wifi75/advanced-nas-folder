# Variabili lette da docker-compose.yml per comporre lo stack (percorsi dei
# volumi, porta, UID/GID) — non dall'applicazione: quella legge il .env alla
# radice del progetto, indicato a env_file nel compose. Copiare in
# deploy/docker/.env.

# UID e GID dell'utente di sistema "anf" creato da install.sh sull'host:
# scoprirli con `id anf`. Devono combaciare, altrimenti il container non
# legge ne' scrive i volumi.
ANF_UID=999
ANF_GID=999

# Stessi percorsi usati dall'installazione nativa (vedi docs/INSTALL.md).
ANF_DATA_DIR=/var/lib/anf
ANF_MOUNT_ROOT=/srv/nas
ANF_SOCKET_DIR=/run/anf

# Stessa porta scelta durante l'installazione nativa: deve combaciare con
# ANF_PORT nel .env alla radice e con la configurazione del web server.
ANF_PORT=8100
