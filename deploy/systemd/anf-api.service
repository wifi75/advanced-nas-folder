[Unit]
Description=Advanced NAS Folder - API
Documentation=https://github.com/wifi75/advanced-nas-folder
After=network.target anf-agent.service
Requires=anf-agent.service

[Service]
Type=exec
# Utente non privilegiato: questa applicazione non deve poter toccare il sistema.
User=@@UTENTE@@
Group=@@GRUPPO@@
WorkingDirectory=@@RADICE@@/backend
EnvironmentFile=@@RADICE@@/.env
ExecStart=@@RADICE@@/venv/bin/uvicorn app.main:app     --host ${ANF_HOST} --port ${ANF_PORT} --proxy-headers
Restart=on-failure
RestartSec=5

# Isolamento
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=@@RADICE@@ @@DATI@@ @@MOUNT_ROOT@@
StateDirectory=anf
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
