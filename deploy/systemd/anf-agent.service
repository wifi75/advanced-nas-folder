[Unit]
Description=Advanced NAS Folder - agent privilegiato
Documentation=https://github.com/wifi75/advanced-nas-folder
After=network-online.target
Wants=network-online.target

[Service]
# `simple` e non `notify`: l'agent non manda a systemd il segnale di pronto, e
# dichiarare `notify` lo farebbe attendere un messaggio che non arriva mai.
Type=simple

# Gira da root perche monta filesystem e ricarica il web server. Per questo e
# un processo separato, minimale e senza dipendenze esterne: l'applicazione web
# non gira MAI con questi privilegi.
User=root

# Il gruppo serve alla cartella del socket, non ai privilegi: l'agent resta
# root. Senza, systemd la crea root:root 0750 e l'utente `anf` non riesce
# nemmeno ad attraversarla: il socket c'e, ha i permessi giusti, e l'API lo
# vede comunque come irraggiungibile.
Group=@@GRUPPO@@
RuntimeDirectory=anf
RuntimeDirectoryMode=0750
# Senza, ad ogni riavvio del servizio (anche solo per un aggiornamento)
# systemd cancella e ricrea /run/anf da zero. Se anf-api gira in un
# container Docker con quella cartella montata come bind mount (deploy/docker/
# docker-compose.yml), il container resta agganciato alla cartella VECCHIA —
# ormai orfana — e non vede piu' il socket ricreato in quella nuova, finche'
# anche il container non viene ricreato. "yes" la lascia al suo posto tra un
# riavvio e l'altro: sparisce solo al riavvio della macchina, quando comunque
# anche il container Docker riparte da zero e la rimonta di nuovo.
RuntimeDirectoryPreserve=yes

# L'agent non e installato nel venv di proposito: non ha dipendenze, e
# aggiungerlo la lo legherebbe al ciclo di vita del backend. Basta dire a
# Python dove trovarlo.
Environment=PYTHONPATH=@@RADICE@@/agent
Environment=ANF_AGENT_SOCKET=@@SOCKET@@
Environment=ANF_MOUNT_ROOT=@@MOUNT_ROOT@@
Environment=ANF_AGENT_GROUP=@@GRUPPO@@
ExecStart=@@RADICE@@/venv/bin/python -m anf_agent

Restart=on-failure
RestartSec=5

# Riduzione della superficie. Attenzione: NON si puo usare PrivateNetwork, che
# isolerebbe l'agent in uno spazio di rete con la sola interfaccia di loopback:
# i mount NFS avvengono nello spazio di rete di chi li chiede, e da li il NAS
# sarebbe irraggiungibile.
PrivateTmp=yes
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
NoNewPrivileges=no
LockPersonality=yes

[Install]
WantedBy=multi-user.target
