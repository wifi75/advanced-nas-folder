[Unit]
Description=Advanced NAS Folder - agent privilegiato
Documentation=https://github.com/wifi75/advanced-nas-folder
After=network.target

[Service]
Type=notify
# Gira da root perche monta filesystem e ricarica il web server.
# Per questo motivo e un processo separato, minimale e senza dipendenze esterne:
# l'applicazione web non gira MAI con questi privilegi.
User=root
Group=root
RuntimeDirectory=anf
RuntimeDirectoryMode=0750
ExecStart=/var/www/advanced-nas-folder/venv/bin/python -m anf_agent
Restart=on-failure
RestartSec=5

# Riduzione della superficie: l'agent non ha bisogno di rete.
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
NoNewPrivileges=no
LockPersonality=yes

[Install]
WantedBy=multi-user.target
