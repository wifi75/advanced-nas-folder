# Il progetto viene installato su Linux: tutto il testo va normalizzato a LF.
# Senza questa regola gli script e le unit systemd finirebbero nel repository con
# fine riga Windows e non verrebbero eseguiti sul server.
* text=auto eol=lf

# File che devono essere LF senza eccezioni
*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.mount   text eol=lf
*.conf    text eol=lf
*.tpl     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Binari: mai toccati
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.tar.gz binary
